# Server Port & Env
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/swariya_jewel_db

# Auth Secrets
JWT_SECRET=swariya_jewellers_jwt_secret_key_2026
JWT_EXPIRES_IN=1d

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID=TEST10000000000000000000
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_MOCK
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01

# ImageKit.io Storage Credentials
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Cloudflare R2 Storage Credentials (10GB Free Egress-Free Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=swariya-jewelry-media
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev
